cabal-version: 3.0
name:          contract-billing
version:       0.16.0
synopsis:      Vertragsbuchung: Sollstellung der Verträge im Hauptbuch
description:
  CoreMesh-Plugin in Haskell. Bucht die fälligen Konditionen der Verträge
  (Plugin contract) über die Vorerfassung des Hauptbuchs (Plugin ledger):
  Vorerfassung anlegen, Positionen füllen, buchen – je Vertrag und
  Fälligkeitstag ein Beleg, seit der letzten Buchung bis zu einem Stichtag.
  Ohne eigene Daten und ohne SQL: Stammdaten als Kopie im Speicher, über
  SystemEvents aktuell; Läufe und Sollstellungen hält das Vertragsmodul.
license:       NONE
build-type:    Simple

common lang
  default-language:   GHC2021
  default-extensions: OverloadedStrings, LambdaCase, RecordWildCards, DerivingStrategies
  ghc-options:        -Wall -Wno-name-shadowing

library
  import:          lang
  hs-source-dirs:  src
  exposed-modules:
    Billing.Api
    Billing.Cache
    Billing.Data
    Billing.Depreciation
    Billing.Loan
    Billing.OpCost
    Billing.OpCostRun
    Billing.Plan
    Billing.Pricing
    Billing.Run
    Billing.Schedule
    Billing.Settlement
  build-depends:
      base            >= 4.18 && < 5
    , aeson           >= 2.1  && < 2.3
    , bytestring      >= 0.11 && < 0.13
    , containers      >= 0.6  && < 0.9
    , coremesh-plugin >= 0.1  && < 0.2
    , crypton         >= 1.0  && < 2.2
    , http-types      >= 0.12 && < 0.13
    , ram             >= 0.20 && < 0.23
    , scientific      >= 0.3  && < 0.4
    , stm             >= 2.5  && < 2.6
    , text            >= 2.0  && < 2.2
    , time            >= 1.12 && < 1.15
    , vector          >= 0.13 && < 0.14

executable contract-billing
  import:          lang
  hs-source-dirs:  app
  main-is:         Main.hs
  ghc-options:     -threaded -rtsopts
  build-depends:
      base
    , contract-billing
    , coremesh-plugin

test-suite spec
  import:          lang
  type:            exitcode-stdio-1.0
  hs-source-dirs:  test
  main-is:         Main.hs
  build-depends:
      base
    , containers
    , contract-billing
    , text
    , time
