cabal-version: 3.0
name:          profit-loss
version:       0.2.0
synopsis:      Auswertungen des Hauptbuchs: GuV je Gebäude, Saldenliste, Kontoblatt
description:
  CoreMesh-Plugin in Haskell. Rechnet die Gewinn- und Verlustrechnung aus den
  Einzelposten des Hauptbuchs (Plugin ledger): Konten nach Kontotyp in
  Bereiche (Erlöse, Aufwand …), Summen und Ergebnis – auf dem Bildschirm und
  als CSV zum Speichern. Ohne eigene Daten: nichts wird gespeichert.
license:       NONE
build-type:    Simple

common lang
  default-language:   GHC2021
  default-extensions: OverloadedStrings, LambdaCase, RecordWildCards, DerivingStrategies
  ghc-options:        -Wall -Wno-name-shadowing

library
  import:          lang
  hs-source-dirs:  src
  exposed-modules:
    ProfitLoss.Api
    ProfitLoss.Ledger
    ProfitLoss.Meta
    ProfitLoss.Objects
    ProfitLoss.Report
  build-depends:
      base            >= 4.18 && < 5
    , aeson           >= 2.1  && < 2.3
    , bytestring      >= 0.11 && < 0.13
    , containers      >= 0.6  && < 0.9
    , coremesh-plugin >= 0.1  && < 0.2
    , ram             >= 0.20 && < 0.23
    , scientific      >= 0.3  && < 0.4
    , text            >= 2.0  && < 2.2
    , time            >= 1.12 && < 1.15

executable profit-loss
  import:          lang
  hs-source-dirs:  app
  main-is:         Main.hs
  ghc-options:     -threaded -rtsopts
  build-depends:
      base
    , profit-loss
    , coremesh-plugin

test-suite spec
  import:          lang
  type:            exitcode-stdio-1.0
  hs-source-dirs:  test
  main-is:         Main.hs
  build-depends:
      base
    , aeson
    , containers
    , profit-loss
    , text
    , time
